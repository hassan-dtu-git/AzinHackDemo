# Copy to .env for local backend development. Never commit real credentials.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Configure only after checking the current official TinyFish API documentation.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=

# Choose/configure an LLM provider after team agreement.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
